+// ── Window-aware fake of Obsidian's Workspace ───────────────────────────
+//
+// Models just enough of Obsidian's workspace to check *where* a note ends up,
+// regardless of which workspace API an implementation uses to get there.
+// Semantics follow Obsidian:
+// - getLeaf(false) reuses the active leaf if it can navigate (a note or an
+//   empty tab), else the most recently active navigable leaf in the active
+//   leaf's window, else creates a new tab in that window.
+// - getLeaf(true | "tab" | "split") creates a leaf next to the active leaf
+//   (same window). getLeaf("window") creates a leaf in a new pop-out window.
+// - getMostRecentLeaf(root) returns the most recently active leaf under root
+//   (rootSplit, i.e. the main window, by default).
+// - setActiveLeaf(leaf, { focus: true }) and revealLeaf(leaf) activate the
+//   leaf and focus its window.
+
+type FakeRoot = { win: MockWindow; doc: MockDocument };
+type FakeLeafOrigin = "initial" | "tab" | "split" | "window";
+
+function makeFakeView(type: string, doc: MockDocument, file?: TFile) {
+	return { getViewType: () => type, containerEl: new MockElement("div", doc), file: file ?? null };
+}
+
+class FakeLeaf extends WorkspaceLeaf {
+	containerEl: MockElement;
+	pinned = false;
+
+	constructor(
+		readonly workspace: FakeWorkspace,
+		readonly root: FakeRoot,
+		readonly origin: FakeLeafOrigin,
+	) {
+		super();
+		this.containerEl = new MockElement("div", root.doc);
+		this.view = makeFakeView("empty", root.doc);
+	}
+
+	get viewType(): string | undefined {
+		return (this.view as { getViewType?: () => string } | null)?.getViewType?.();
+	}
+
+	get filePath(): string | null {
+		return (this.view as { file?: TFile | null } | null)?.file?.path ?? null;
+	}
+
+	getRoot(): FakeRoot {
+		return this.root;
+	}
+
+	getContainer(): FakeRoot {
+		return this.root;
+	}
+
+	openFile(file: TFile, openState?: { active?: boolean }): Promise<void> {
+		this.view = makeFakeView("markdown", this.root.doc, file);
+		if (openState?.active) this.workspace.setActiveLeaf(this, { focus: true });
+		return Promise.resolve();
+	}
+}
+
+class FakeWorkspace extends Workspace {
+	rootSplit: FakeRoot;
+	leaves: FakeLeaf[] = [];
+	activeLeaf: FakeLeaf | null = null;
+	focusedWindow: MockWindow | null = null;
+	private history: FakeLeaf[] = [];
+
+	constructor(
+		mainWindow: MockWindow,
+		private readonly vault: { getAbstractFileByPath(path: string): unknown },
+	) {
+		super();
+		this.rootSplit = { win: mainWindow, doc: mainWindow.document };
+	}
+
+	addLeaf(root: FakeRoot, origin: FakeLeafOrigin): FakeLeaf {
+		const leaf = new FakeLeaf(this, root, origin);
+		this.leaves.push(leaf);
+		return leaf;
+	}
+
+	private canNavigate(leaf: FakeLeaf): boolean {
+		return !leaf.pinned && (leaf.viewType === "markdown" || leaf.viewType === "empty");
+	}
+
+	getLeavesOfType(type: string): WorkspaceLeaf[] {
+		return this.leaves.filter((l) => l.viewType === type);
+	}
+
+	iterateAllLeaves(callback: (leaf: WorkspaceLeaf) => unknown): void {
+		for (const leaf of [...this.leaves]) callback(leaf);
+	}
+
+	getLeaf(newLeaf?: unknown, _direction?: unknown): WorkspaceLeaf {
+		const activeRoot = this.activeLeaf?.root ?? this.rootSplit;
+		if (newLeaf === "window") {
+			const win = new MockWindow();
+			return this.addLeaf({ win, doc: win.document }, "window");
+		}
+		if (newLeaf === "split") return this.addLeaf(activeRoot, "split");
+		if (newLeaf === true || newLeaf === "tab") return this.addLeaf(activeRoot, "tab");
+
+		if (this.activeLeaf && this.canNavigate(this.activeLeaf)) return this.activeLeaf;
+		const recent = [...this.history]
+			.reverse()
+			.find((l) => l.root === activeRoot && this.canNavigate(l) && this.leaves.includes(l));
+		return recent ?? this.addLeaf(activeRoot, "tab");
+	}
+
+	getMostRecentLeaf(root?: unknown): WorkspaceLeaf | null {
+		const target = root ?? this.rootSplit;
+		const recent = [...this.history].reverse().find((l) => l.root === target && this.leaves.includes(l));
+		return recent ?? this.leaves.find((l) => l.root === target) ?? null;
+	}
+
+	createLeafBySplit(leaf: WorkspaceLeaf, _direction?: unknown): WorkspaceLeaf {
+		return this.addLeaf((leaf as FakeLeaf).root, "split");
+	}
+
+	setActiveLeaf(leaf: WorkspaceLeaf, params?: { focus?: boolean }): void {
+		const fake = leaf as FakeLeaf;
+		this.activeLeaf = fake;
+		this.history.push(fake);
+		if (params?.focus) this.focusedWindow = fake.root.win;
+	}
+
+	revealLeaf(leaf: WorkspaceLeaf): Promise<void> {
+		this.setActiveLeaf(leaf, { focus: true });
+		return Promise.resolve();
+	}
+
+	async openLinkText(linktext: string, _sourcePath: string, newLeaf?: unknown): Promise<void> {
+		const file = this.vault.getAbstractFileByPath(linktext) ?? this.vault.getAbstractFileByPath(`${linktext}.md`);
+		if (!(file instanceof TFile)) return;
+		await this.getLeaf(newLeaf).openFile(file, { active: true });
+	}
+}
