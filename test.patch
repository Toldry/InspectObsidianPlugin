+	describe("opening notes from the graph (pop-out window routing)", () => {
+		const TARGET = "entries/2024-01-01 Note.md";
+		const EXISTING = "entries/2023-12-31 Existing.md";
+
+		type Setup = {
+			graphIn: "main" | "popout";
+			mainHasNote?: boolean;
+			popoutHasNote?: boolean;
+		};
+
+		function makeFile(path: string): TFile {
+			const file = new TFile();
+			file.path = path;
+			file.extension = "md";
+			file.basename = path.split("/").pop()!.replace(/\.md$/, "");
+			return file;
+		}
+
+		function setup({ graphIn, mainHasNote = true, popoutHasNote = false }: Setup) {
+			const app = new App();
+			const files = new Map([TARGET, EXISTING].map((p) => [p, makeFile(p)]));
+			vi.spyOn(app.vault, "getAbstractFileByPath").mockImplementation((p: string) => files.get(p) ?? null);
+			const workspace = new FakeWorkspace(mainWindow, app.vault);
+			app.workspace = workspace;
+			plugin.app = app;
+
+			const mainLeaf = workspace.addLeaf(workspace.rootSplit, "initial");
+			if (mainHasNote) void mainLeaf.openFile(files.get(EXISTING)!);
+			workspace.setActiveLeaf(mainLeaf, { focus: true });
+
+			const popoutRoot: FakeRoot = { win: popoutWindow, doc: popoutWindow.document };
+			const graphRoot = graphIn === "main" ? workspace.rootSplit : popoutRoot;
+			const graphLeaf = workspace.addLeaf(graphRoot, "initial");
+			const view = new DaylioGraphView(graphLeaf, plugin);
+			(view as any).app = app;
+			(view as any).containerEl =
+				graphIn === "main" ? new MockElement("div", mainWindow.document) : containerEl;
+			graphLeaf.view = view;
+
+			let popoutNoteLeaf: FakeLeaf | null = null;
+			if (popoutHasNote) {
+				popoutNoteLeaf = workspace.addLeaf(popoutRoot, "initial");
+				void popoutNoteLeaf.openFile(files.get(EXISTING)!);
+				workspace.setActiveLeaf(popoutNoteLeaf, { focus: true });
+			}
+
+			// The user clicks inside the graph, which makes its leaf active.
+			workspace.setActiveLeaf(graphLeaf, { focus: true });
+			const leavesBefore = [...workspace.leaves];
+
+			const click = async (mods: { ctrlKey?: boolean; altKey?: boolean; shiftKey?: boolean } = {}) => {
+				(view as any).openFile(TARGET, new MockMouseEvent("click", mods) as unknown as MouseEvent);
+				for (let i = 0; i < 5; i++) await new Promise((r) => setTimeout(r, 0));
+			};
+			const leavesShowingTarget = () => workspace.leaves.filter((l) => l.filePath === TARGET);
