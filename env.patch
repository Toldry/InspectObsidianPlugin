+
+export type PaneType = "tab" | "split" | "window";
+
+export class Keymap {
+	/**
+	 * Mirrors Obsidian's mapping from a mouse/keyboard event to a pane type:
+	 * Mod+Alt+Shift → "window", Mod+Alt → "split", Mod or middle-click → "tab",
+	 * otherwise false. "Mod" is Ctrl on Windows/Linux and Cmd on macOS.
+	 */
+	static isModEvent(
+		evt?: { ctrlKey?: boolean; metaKey?: boolean; altKey?: boolean; shiftKey?: boolean; button?: number } | null,
+	): PaneType | boolean {
+		if (!evt) return false;
+		const mod = !!(evt.ctrlKey || evt.metaKey);
+		if (mod && evt.altKey && evt.shiftKey) return "window";
+		if (mod && evt.altKey) return "split";
+		if (mod || evt.button === 1) return "tab";
+		return false;
+	}
 }
 
